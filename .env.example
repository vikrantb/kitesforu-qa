# KitesForU QA Environment Variables
# Copy to .env and fill in values

# ===========================================
# Required for Content Evaluation (Gemini)
# ===========================================
# Get from: gcloud secrets versions access latest --secret=google-ai-api-key --project=kitesforu-dev
# Or: https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=

# ===========================================
# Optional - For Speaker Diarization
# ===========================================
# Get from: https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=

# ===========================================
# GCP Configuration (for GCS audio files)
# ===========================================
GCP_PROJECT=kitesforu-dev

# ===========================================
# Model Settings (optional, these are defaults)
# ===========================================
# Whisper model: tiny, base, small, medium, large-v3
WHISPER_MODEL=base

# Gemini model for content evaluation
LLM_MODEL=gemini-2.0-flash

# Temp directory for downloads
KQA_TEMP_DIR=/tmp/kitesforu-qa

# ===========================================
# For E2E Tests (kqa e2e command)
# ===========================================
# Get from: gcloud secrets versions access latest --secret=TEST_API_KEY --project=kitesforu-dev
# This is a special test API key that only works in DEV mode
KITESFORU_API_KEY=
KITESFORU_API_URL=https://kitesforu-api-m6zqve5yda-uc.a.run.app
